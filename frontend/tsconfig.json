
{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    // A handful of components (PerformanceForecastPanel.jsx and its
    // siblings) are plain .jsx, not .tsx — Vite's own build (esbuild)
    // already handled them fine either way; this just lets `tsc
    // --noEmit` (this session's own type-check step) import them
    // too, now that PerformanceForecastPage.tsx etc. do.
    "allowJs": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "vite.config.ts"]
}
