# pointed at the same live Render backend so both UIs share one API/data.
VITE_API_URL=https://petrazim-trading-backend.onrender.com
VITE_WS_URL=wss://petrazim-trading-backend.onrender.com/ws
VITE_SUPABASE_URL=https://eacpktuyicxutatxuokw.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_CqcWu1zhFDKaFW7uBnIt1Q_tn3aU3xM

# The Nube VM's Coolify-deployed backup backend — lib/backendFailover.ts's
# real failover target when Render is unreachable. Committed here (like
# every other VITE_ value above) rather than only set in Vercel's own
# dashboard: Vercel adding a VITE_-prefixed dashboard var as "Sensitive"
# refuses to inline it into the client build (defeats the point — a
# failover URL has to reach the browser to be useful, same as
# VITE_API_URL already does), and this repo's build already reads
# .env.production directly, so a dashboard entry was never actually
# required. A public backend URL isn't a secret regardless — it's meant
# to be embedded in a public browser bundle, same as VITE_API_URL.
VITE_VM_API_URL=https://oz1vwmxurydvxlt53hviuefh.64.118.141.96.sslip.io
